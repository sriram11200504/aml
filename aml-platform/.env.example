MODEL_API_URL=http://localhost:8200
USE_SQLITE=true
DATABASE_URL=sqlite+aiosqlite:///./data/aml.db

# AML server
HOST=0.0.0.0
PORT=8100
DASHBOARD_ORIGIN=http://localhost:4000

# Per-bank ingest API keys (comma-separated KEY=BANK_ID pairs)
INGEST_API_KEYS=aml-secret-key-01=fakebank-01

# Bank compliance callbacks (comma-separated BANK_ID=URL:KEY pairs)
BANK_COMPLIANCE_CONFIGS=fakebank-01=http://localhost:8000:compliance-secret-key-01

# Risk thresholds
THRESHOLD_MEDIUM=0.4
THRESHOLD_HIGH=0.6
THRESHOLD_CRITICAL=0.8

# Postgres (when USE_SQLITE=false)
POSTGRES_USER=amluser
POSTGRES_PASSWORD=amlpass
POSTGRES_DB=amldb
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
