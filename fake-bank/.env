BANK_ID=fakebank-01
DATABASE_URL=sqlite:///./data/bank.db
USE_SQLITE=true

# AML Platform
AML_URL=http://localhost:8100
AML_API_KEY=aml-secret-key-01

# Compliance (AML -> Bank)
COMPLIANCE_API_KEY=compliance-secret-key-01

# Server
HOST=0.0.0.0
PORT=8000
FRONTEND_ORIGIN=http://localhost:3000

# Postgres (used when USE_SQLITE=false)
POSTGRES_USER=bankuser
POSTGRES_PASSWORD=bankpass
POSTGRES_DB=bankdb
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
